$csharpCode = @"
using System;
using System.IO;
using System.Net.WebSockets;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

public class MiniMqttWss {
    private ClientWebSocket ws = new ClientWebSocket();

    public async Task<bool> ConnectAsync(string url, string clientId) {
        try {
            ws.Options.AddSubProtocol("mqtt");
            var cts = new CancellationTokenSource(4500);
            await ws.ConnectAsync(new Uri(url), cts.Token);

            byte[] idBytes = Encoding.UTF8.GetBytes(clientId);
            int remLen = 10 + 2 + idBytes.Length;
            using (var ms = new MemoryStream()) {
                ms.WriteByte(0x10);
                WriteVarInt(ms, remLen);
                ms.Write(new byte[] { 0x00, 0x04, (byte)'M', (byte)'Q', (byte)'T', (byte)'T', 0x04, 0x02, 0x00, 0x3C }, 0, 10);
                ms.WriteByte((byte)(idBytes.Length >> 8));
                ms.WriteByte((byte)(idBytes.Length & 0xFF));
                ms.Write(idBytes, 0, idBytes.Length);
                byte[] pkt = ms.ToArray();
                await ws.SendAsync(new ArraySegment<byte>(pkt), WebSocketMessageType.Binary, true, CancellationToken.None);
            }
            byte[] buf = new byte[64];
            var res = await ws.ReceiveAsync(new ArraySegment<byte>(buf), cts.Token);
            return res.Count >= 4 && buf[0] == 0x20 && buf[3] == 0x00;
        } catch { return false; }
    }

    public async Task SubscribeAsync(string topic) {
        byte[] tBytes = Encoding.UTF8.GetBytes(topic);
        int remLen = 2 + 2 + tBytes.Length + 1;
        using (var ms = new MemoryStream()) {
            ms.WriteByte(0x82);
            WriteVarInt(ms, remLen);
            ms.Write(new byte[] { 0x00, 0x01 }, 0, 2);
            ms.WriteByte((byte)(tBytes.Length >> 8));
            ms.WriteByte((byte)(tBytes.Length & 0xFF));
            ms.Write(tBytes, 0, tBytes.Length);
            ms.WriteByte(0x00);
            byte[] pkt = ms.ToArray();
            await ws.SendAsync(new ArraySegment<byte>(pkt), WebSocketMessageType.Binary, true, CancellationToken.None);
        }
    }

    public async Task PublishAsync(string topic, string payload) {
        byte[] tBytes = Encoding.UTF8.GetBytes(topic);
        byte[] pBytes = Encoding.UTF8.GetBytes(payload);
        int remLen = 2 + tBytes.Length + pBytes.Length;
        using (var ms = new MemoryStream()) {
            ms.WriteByte(0x30);
            WriteVarInt(ms, remLen);
            ms.WriteByte((byte)(tBytes.Length >> 8));
            ms.WriteByte((byte)(tBytes.Length & 0xFF));
            ms.Write(tBytes, 0, tBytes.Length);
            ms.Write(pBytes, 0, pBytes.Length);
            byte[] pkt = ms.ToArray();
            await ws.SendAsync(new ArraySegment<byte>(pkt), WebSocketMessageType.Binary, true, CancellationToken.None);
        }
    }

    public async Task<string> ReceivePayloadAsync() {
        byte[] buffer = new byte[65536];
        using (var ms = new MemoryStream()) {
            WebSocketReceiveResult result;
            do {
                result = await ws.ReceiveAsync(new ArraySegment<byte>(buffer), CancellationToken.None);
                if (result.MessageType == WebSocketMessageType.Close) return null;
                ms.Write(buffer, 0, result.Count);
            } while (!result.EndOfMessage);

            byte[] data = ms.ToArray();
            if (data.Length < 4 || (data[0] & 0xF0) != 0x30) return "";

            int idx = 1;
            int multiplier = 1, value = 0;
            byte encodedByte;
            do {
                encodedByte = data[idx++];
                value += (encodedByte & 127) * multiplier;
                multiplier *= 128;
            } while ((encodedByte & 128) != 0);

            int topicLen = (data[idx] << 8) | data[idx + 1];
            idx += 2 + topicLen;
            return Encoding.UTF8.GetString(data, idx, data.Length - idx);
        }
    }

    private void WriteVarInt(Stream s, int len) {
        do {
            byte b = (byte)(len % 128);
            len /= 128;
            if (len > 0) b |= 128;
            s.WriteByte(b);
        } while (len > 0);
    }
}

// 纯本地离线 QR Code Version 2-L (25x25) 矩阵生成器
public class OfflineQr {
    private const int Size = 25;
    private bool[,] modules = new bool[Size, Size];
    private bool[,] isFunc = new bool[Size, Size];

    public static string RenderTerminal(string text) {
        var qr = new OfflineQr();
        qr.Encode(text);
        var sb = new StringBuilder();
        int pad = 2; // 四周白边静默区
        int total = Size + pad * 2;
        for (int y = 0; y < total; y += 2) {
            sb.Append("  ");
            for (int x = 0; x < total; x++) {
                bool topDark = qr.GetModule(x - pad, y - pad);
                bool botDark = (y + 1 < total) ? qr.GetModule(x - pad, y + 1 - pad) : false;
                // 黑底终端白字反转渲染：亮块代表白底，暗块代表黑码
                if (!topDark && !botDark) sb.Append('\u2588');      // █ 上白下白
                else if (!topDark && botDark) sb.Append('\u2580');  // ▀ 上白下黑
                else if (topDark && !botDark) sb.Append('\u2584');  // ▄ 上黑下白
                else sb.Append(' ');                                //   上黑下黑
            }
            sb.AppendLine();
        }
        return sb.ToString();
    }

    private bool GetModule(int x, int y) {
        if (x < 0 || y < 0 || x >= Size || y >= Size) return false;
        return modules[y, x];
    }

    private void Encode(string text) {
        byte[] raw = Encoding.ASCII.GetBytes(text);
        // 1. 构造 34 字节数据码字 (Version 2-L)
        byte[] data = new byte[34];
        int bitPos = 0;
        Action<int, int> putBits = (val, len) => {
            for (int i = len - 1; i >= 0; i--) {
                if (((val >> i) & 1) != 0) data[bitPos >> 3] |= (byte)(1 << (7 - (bitPos & 7)));
                bitPos++;
            }
        };
        putBits(0x4, 4); // Byte mode
        putBits(raw.Length, 8);
        foreach (byte b in raw) putBits(b, 8);
        putBits(0, 4);   // Terminator
        int byteIdx = (bitPos + 7) >> 3;
        byte[] pads = { 0xEC, 0x11 };
        for (int i = 0; byteIdx < 34; i++, byteIdx++) data[byteIdx] = pads[i & 1];

        // 2. Reed-Solomon 计算 10 字节纠错码
        byte[] ecc = ComputeEcc(data, 10);
        byte[] allBytes = new byte[44];
        Array.Copy(data, 0, allBytes, 0, 34);
        Array.Copy(ecc, 0, allBytes, 34, 10);

        // 3. 绘制功能图形
        DrawFinder(0, 0); DrawFinder(Size - 7, 0); DrawFinder(0, Size - 7);
        DrawAlignment(18, 18);
        for (int i = 8; i < Size - 8; i++) {
            SetFunc(i, 6, i % 2 == 0);
            SetFunc(6, i, i % 2 == 0);
        }
        SetFunc(8, Size - 8, true); // Dark module
        ReserveFormat();

        // 4. 蛇形填充数据位 + Mask 0 ((x + y) % 2 == 0)
        int bitIdx = 0;
        bool up = true;
        for (int right = Size - 1; right >= 1; right -= 2) {
            if (right == 6) right = 5;
            for (int vert = 0; vert < Size; vert++) {
                int y = up ? (Size - 1 - vert) : vert;
                for (int j = 0; j < 2; j++) {
                    int x = right - j;
                    if (!isFunc[y, x]) {
                        bool bit = false;
                        if (bitIdx < allBytes.Length * 8) {
                            bit = ((allBytes[bitIdx >> 3] >> (7 - (bitIdx & 7))) & 1) != 0;
                            bitIdx++;
                        }
                        if ((x + y) % 2 == 0) bit = !bit;
                        modules[y, x] = bit;
                    }
                }
            }
            up = !up;
        }

        // 5. 写入 Format Info (ECC L = 01, Mask 0 = 000 -> 0x77C4)
        int fmt = 0x77C4;
        for (int i = 0; i <= 5; i++) SetFunc(8, i, ((fmt >> i) & 1) != 0);
        SetFunc(8, 7, ((fmt >> 6) & 1) != 0);
        SetFunc(8, 8, ((fmt >> 7) & 1) != 0);
        SetFunc(7, 8, ((fmt >> 8) & 1) != 0);
        for (int i = 9; i < 15; i++) SetFunc(14 - i, 8, ((fmt >> i) & 1) != 0);
        for (int i = 0; i < 8; i++) SetFunc(Size - 1 - i, 8, ((fmt >> i) & 1) != 0);
        for (int i = 8; i < 15; i++) SetFunc(8, Size - 15 + i, ((fmt >> i) & 1) != 0);
    }

    private void SetFunc(int x, int y, bool dark) { modules[y, x] = dark; isFunc[y, x] = true; }

    private void DrawFinder(int x, int y) {
        for (int dy = -1; dy <= 7; dy++)
            for (int dx = -1; dx <= 7; dx++) {
                int xx = x + dx, yy = y + dy;
                if (xx >= 0 && yy >= 0 && xx < Size && yy < Size) {
                    bool dark = (dx >= 0 && dx <= 6 && dy >= 0 && dy <= 6) &&
                                (dx == 0 || dx == 6 || dy == 0 || dy == 6 || (dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4));
                    SetFunc(xx, yy, dark);
                }
            }
    }

    private void DrawAlignment(int cx, int cy) {
        for (int dy = -2; dy <= 2; dy++)
            for (int dx = -2; dx <= 2; dx++) {
                bool dark = Math.Abs(dx) == 2 || Math.Abs(dy) == 2 || (dx == 0 && dy == 0);
                SetFunc(cx + dx, cy + dy, dark);
            }
    }

    private void ReserveFormat() {
        for (int i = 0; i < 9; i++) { isFunc[8, i] = true; isFunc[i, 8] = true; }
        for (int i = 0; i < 8; i++) { isFunc[8, Size - 1 - i] = true; isFunc[Size - 1 - i, 8] = true; }
    }

    private byte[] ComputeEcc(byte[] data, int eccLen) {
        byte[] gen = new byte[eccLen + 1];
        gen[0] = 1;
        byte root = 1;
        for (int i = 0; i < eccLen; i++) {
            for (int j = i + 1; j >= 1; j--) gen[j] = (byte)(gen[j] ^ GfMul(gen[j - 1], root));
            root = GfMul(root, 2);
        }
        byte[] rem = new byte[eccLen];
        foreach (byte b in data) {
            byte factor = (byte)(b ^ rem[0]);
            Array.Copy(rem, 1, rem, 0, eccLen - 1);
            rem[eccLen - 1] = 0;
            for (int j = 0; j < eccLen; j++) rem[j] = (byte)(rem[j] ^ GfMul(gen[j + 1], factor));
        }
        return rem;
    }

    private byte GfMul(byte x, byte y) {
        int r = 0;
        for (int i = 7; i >= 0; i--) {
            r = (r << 1) ^ ((r >> 7) * 0x11D);
            r ^= ((y >> i) & 1) * x;
        }
        return (byte)r;
    }
}
"@
Add-Type -TypeDefinition $csharpCode -Language CSharp

$brokers = @(
    @{ Name = "EMQX-Global"; Url = "wss://broker.emqx.io:8084/mqtt" },
    @{ Name = "EMQX-CN";     Url = "wss://broker-cn.emqx.io:8084/mqtt" },
    @{ Name = "Mosquitto";   Url = "wss://test.mosquitto.org:8081/mqtt" },
    @{ Name = "HiveMQ";      Url = "wss://broker.hivemq.com:8884/mqtt" }
)

$mqtt = New-Object MiniMqttWss
$roomId = Get-Random -Minimum 100000 -Maximum 999999
$connectedIdx = -1

Write-Host "`n[*] Probing public WSS relay nodes..." -ForegroundColor Cyan
for ($i = 0; $i -lt $brokers.Count; $i++) {
    $b = $brokers[$i]
    Write-Host ("    Node {0} [{1,-11}] ... " -f $i, $b.Name) -NoNewline
    $ok = $mqtt.ConnectAsync($b.Url, "ps_host_$roomId").GetAwaiter().GetResult()
    if ($ok) {
        Write-Host "OK!" -ForegroundColor Green
        $connectedIdx = $i
        break
    } else {
        Write-Host "Timeout" -ForegroundColor DarkGray
    }
}

if ($connectedIdx -eq -1) {
    Write-Host "[!] All public nodes unreachable. Check internet." -ForegroundColor Red
    return
}

$pairCode = "$connectedIdx-$roomId"
$topicIn  = "campus_xfer/$pairCode/to_host"
$topicOut = "campus_xfer/$pairCode/to_guest"
[void]$mqtt.SubscribeAsync($topicIn).GetAwaiter().GetResult()

[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
Clear-Host

# 强制等宽框线对齐输出
$border = "+---------------------------------------------------+"
Write-Host $border -ForegroundColor Green
Write-Host ("| {0,-49} |" -f "[READY] Fileless P2P Receiver Online") -ForegroundColor Green
Write-Host ("| {0,-49} |" -f "[PAIR CODE] Enter on phone:  $pairCode") -ForegroundColor Yellow
Write-Host ("| {0,-49} |" -f "[SAVE PATH] Auto-save to Desktop") -ForegroundColor Cyan
Write-Host "$border`n" -ForegroundColor Green

# 离线秒级生成并打印终端二维码
$qrMatrix = [OfflineQr]::RenderTerminal("XFER:$pairCode")
Write-Host $qrMatrix -ForegroundColor White

$desktopPath = [Environment]::GetFolderPath("Desktop")
$chunks = @{}
$fileMeta = $null

while ($true) {
    $jsonStr = $mqtt.ReceivePayloadAsync().GetAwaiter().GetResult()
    if ($null -eq $jsonStr) { Write-Host "[!] Disconnected"; break }
    if ($jsonStr -eq "") { continue }

    $msg = $jsonStr | ConvertFrom-Json
    if ($msg.type -eq "ping") {
        [void]$mqtt.PublishAsync($topicOut, '{"type":"pong"}').GetAwaiter().GetResult()
        Write-Host "[+] Phone connected! Waiting for files..." -ForegroundColor Green
    }
    elseif ($msg.type -eq "file-meta") {
        $fileMeta = $msg
        $chunks = @{}
        Write-Host "[RX] Receiving: $($msg.name) ($([math]::Round($msg.size / 1KB, 1)) KB)..." -ForegroundColor Cyan
    }
    elseif ($msg.type -eq "file-chunk") {
        $chunks[$msg.index] = [Convert]::FromBase64String($msg.data)
        $pct = [math]::Round(($chunks.Count / $fileMeta.totalChunks) * 100)
        Write-Progress -Activity "Receiving $($fileMeta.name)" -Status "$pct%" -PercentComplete $pct

        if ($chunks.Count -eq $fileMeta.totalChunks) {
            Write-Progress -Activity "Receiving $($fileMeta.name)" -Completed
            $savePath = Join-Path $desktopPath $fileMeta.name
            $fs = [System.IO.File]::Create($savePath)
            for ($k = 0; $k -lt $fileMeta.totalChunks; $k++) {
                $fs.Write($chunks[$k], 0, $chunks[$k].Length)
            }
            $fs.Close()
            Write-Host "[OK] Saved to Desktop: $savePath" -ForegroundColor Green
        }
    }
}
